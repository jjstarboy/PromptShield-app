# FREE option 1: Groq (key from console.groq.com/keys, no card needed)
PROVIDER=groq
GROQ_API_KEY=your-groq-key-here

# FREE option 2: Google Gemini (key from Google AI Studio, no card needed)
# PROVIDER=gemini
# GEMINI_API_KEY=your-free-key-here
APP_PASSWORD=choose-an-access-code

# Paid option: Anthropic Claude
# PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-key-here

# Optional
# MODEL_QUICK=gemini-2.5-flash-lite
# MODEL_DEFAULT=gemini-2.5-flash
# MIN_INTERVAL_MS=5000     (pause between AI calls so free limits are not hit)
# RATE_LIMIT=120
# DAILY_CAP=3000
